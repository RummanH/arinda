{
  "name": "arinda-inventory-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install --include=dev",
    "server": "node app.js",
    "dev": "vite",
    "dev:client": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "deploy": "npm run build && npm start",
    "deploy:watch": "concurrently -k -n BUILD,SERVER \"npm:build:watch\" \"npm:start\"",
    "preview": "vite preview",
    "render-build": "npm install --include=dev && npm run build",
    "start": "node app.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
